{
  "name": "@weld/mac",
  "productName": "Weld",
  "version": "0.1.1",
  "description": "An infinite canvas for coding agents, terminals and browsers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite --port 3210",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "app": "vite build && node scripts/package.mjs",
    "start": "electron .",
    "release": "vite build && node scripts/package.mjs --release",
    "smoke": "node scripts/shot.mjs out/smoke test/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.18.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@lydell/node-pty": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@weld/canvas": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.4.1",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
