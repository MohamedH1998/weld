{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  // the app, the MCP endpoint, sign-in and the boards, in one Worker (src/server.ts)
  "main": "src/server.ts",
  "upload_source_maps": true,
  // no request (a board placing a diagram, a picture being drawn) may run longer than this
  "limits": { "cpu_ms": 5000 },
  "observability": { "enabled": true },
  // one per shared board, found by the board's secret key
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  // per address (an IPv6 network as one), per minute: new boards and new links; live connections and agent calls; and
  // new boards from everyone together, so no number of addresses can keep boards faster than this
  "ratelimits": [
    { "name": "NEW_BOARDS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ALL_NEW_BOARDS", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "CALLS", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ]
}
