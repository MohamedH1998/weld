{
  "name": "weld",
  "private": true,
  "description": "An infinite canvas for coding agents: the Mac app, the web canvas, and the canvas engine they share",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @weld/mac dev",
    "dev:web": "pnpm --filter @weld/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "app": "pnpm --filter @weld/mac app --install",
    "smoke": "pnpm --filter @weld/mac smoke"
  }
}
